model Role {
  roleId   Int    @id @default(autoincrement()) @map("role_id")
  roleName String @unique @map("role_name") @db.VarChar(50)
  users    User[]

  @@map("roles")
}

model User {
  userId          Int              @id @default(autoincrement()) @map("user_id")
  fullName        String           @map("full_name") @db.VarChar(100)
  email           String           @unique @db.VarChar(150)
  passwordHash    String           @map("password_hash") @db.VarChar(255)
  phone           String?          @db.VarChar(20)
  roleId          Int              @map("role_id")
  status          UserStatus       @default(active)
  createdAt       DateTime         @default(now()) @map("created_at")
  geofences       Geofence[]
  maintenanceLogs MaintenanceLog[]
  rentals         Rental[]         @relation("StaffRentals")
  role            Role             @relation(fields: [roleId], references: [roleId])

  @@index([roleId], map: "users_role_id_fkey")
  @@map("users")
}

enum UserStatus {
  active
  inactive
}

generator client {
  provider   = "prisma-client-js"
  output     = "../../src/generated"
  engineType = "library"
}

datasource db {
  provider = "mysql"
}

model Geofence {
  geofenceId   Int                  @id @default(autoincrement()) @map("geofence_id")
  geofenceName String               @map("geofence_name") @db.VarChar(100)
  geofenceType GeofenceType         @map("geofence_type")
  centerLat    Decimal?             @map("center_lat") @db.Decimal(10, 7)
  centerLon    Decimal?             @map("center_lon") @db.Decimal(10, 7)
  radiusMeter  Decimal?             @map("radius_meter") @db.Decimal(10, 2)
  polygonData  Json?                @map("polygon_data")
  createdBy    Int                  @map("created_by")
  createdAt    DateTime             @default(now()) @map("created_at")
  creator      User                 @relation(fields: [createdBy], references: [userId])
  geofenceLogs VehicleGeofenceLog[]

  @@index([createdBy], map: "geofences_created_by_fkey")
  @@map("geofences")
}

model VehicleGeofenceLog {
  geofenceLogId Int           @id @default(autoincrement()) @map("geofence_log_id")
  vehicleId     Int           @map("vehicle_id")
  geofenceId    Int           @map("geofence_id")
  eventType     GeofenceEvent @map("event_type")
  latitude      Decimal       @db.Decimal(10, 7)
  longitude     Decimal       @db.Decimal(10, 7)
  createdAt     DateTime      @default(now()) @map("created_at")
  geofence      Geofence      @relation(fields: [geofenceId], references: [geofenceId])
  vehicle       Vehicle       @relation(fields: [vehicleId], references: [vehicleId])

  @@index([vehicleId, createdAt])
  @@index([geofenceId], map: "vehicle_geofence_logs_geofence_id_fkey")
  @@map("vehicle_geofence_logs")
}

enum GeofenceType {
  circle
  polygon
}

enum GeofenceEvent {
  enter
  exit
}

model MaintenanceLog {
  maintenanceId   Int      @id @default(autoincrement()) @map("maintenance_id")
  vehicleId       Int      @map("vehicle_id")
  maintenanceType String   @map("maintenance_type") @db.VarChar(100)
  description     String?  @db.Text
  maintenanceDate DateTime @map("maintenance_date") @db.Date
  currentKm       Decimal  @default(0.00) @map("current_km") @db.Decimal(10, 2)
  cost            Decimal? @db.Decimal(12, 2)
  createdBy       Int      @map("created_by")
  createdAt       DateTime @default(now()) @map("created_at")
  creator         User     @relation(fields: [createdBy], references: [userId])
  vehicle         Vehicle  @relation(fields: [vehicleId], references: [vehicleId])

  @@index([createdBy], map: "maintenance_logs_created_by_fkey")
  @@index([vehicleId], map: "maintenance_logs_vehicle_id_fkey")
  @@map("maintenance_logs")
}

model Customer {
  customerId     Int      @id @default(autoincrement()) @map("customer_id")
  fullName       String   @map("full_name") @db.VarChar(100)
  phone          String   @db.VarChar(20)
  email          String?  @db.VarChar(150)
  identityNumber String?  @map("identity_number") @db.VarChar(30)
  address        String?  @db.Text
  createdAt      DateTime @default(now()) @map("created_at")
  rentals        Rental[]

  @@map("customers")
}

model Rental {
  rentalId     Int            @id @default(autoincrement()) @map("rental_id")
  vehicleId    Int            @map("vehicle_id")
  customerId   Int            @map("customer_id")
  rentedBy     Int            @map("rented_by")
  startTime    DateTime       @map("start_time")
  endTime      DateTime?      @map("end_time")
  startKm      Decimal        @default(0.00) @map("start_km") @db.Decimal(10, 2)
  endKm        Decimal?       @map("end_km") @db.Decimal(10, 2)
  rentalStatus RentalStatus   @default(active) @map("rental_status")
  createdAt    DateTime       @default(now()) @map("created_at")
  gpsLogs      GpsLog[]
  customer     Customer       @relation(fields: [customerId], references: [customerId])
  staff        User           @relation("StaffRentals", fields: [rentedBy], references: [userId])
  vehicle      Vehicle        @relation(fields: [vehicleId], references: [vehicleId])
  rentalFee    Float          @default(0)
  alerts       VehicleAlert[]

  @@index([customerId], map: "rentals_customer_id_fkey")
  @@index([rentedBy], map: "rentals_rented_by_fkey")
  @@index([vehicleId], map: "rentals_vehicle_id_fkey")
  @@map("rentals")
}

enum RentalStatus {
  active
  completed
}

model MonthlyReport {
  reportId       Int      @id @default(autoincrement()) @map("report_id")
  vehicleId      Int      @map("vehicle_id")
  reportMonth    DateTime @map("report_month") @db.Date
  totalKm        Decimal  @default(0.00) @map("total_km") @db.Decimal(10, 2)
  totalAlerts    Int      @default(0) @map("total_alerts")
  totalImpacts   Int      @default(0) @map("total_impacts")
  totalOutOfZone Int      @default(0) @map("total_out_of_zone")
  generatedAt    DateTime @default(now()) @map("generated_at")
  vehicle        Vehicle  @relation(fields: [vehicleId], references: [vehicleId])

  @@unique([vehicleId, reportMonth])
  @@map("monthly_reports")
}

model GpsLog {
  gpsLogId         Int       @id @default(autoincrement()) @map("gps_log_id")
  vehicleId        Int       @map("vehicle_id")
  rentalId         Int?      @map("rental_id")
  latitude         Decimal   @db.Decimal(10, 7)
  longitude        Decimal   @db.Decimal(10, 7)
  speedKmh         Decimal   @default(0.00) @map("speed_kmh") @db.Decimal(5, 2)
  gpsStatus        GpsStatus @default(online) @map("gps_status")
  recordedAt       DateTime  @default(now()) @map("recorded_at")
  distanceFromHome Decimal?  @map("distance_from_home") @db.Decimal(10, 2)
  homeLatitude     Decimal?  @map("home_latitude") @db.Decimal(10, 7)
  homeLongitude    Decimal?  @map("home_longitude") @db.Decimal(10, 7)
  rental           Rental?   @relation(fields: [rentalId], references: [rentalId])
  vehicle          Vehicle   @relation(fields: [vehicleId], references: [vehicleId])

  @@index([vehicleId, recordedAt])
  @@index([rentalId])
  @@map("gps_logs")
}

model VehicleAlert {
  alertId        Int       @id @default(autoincrement()) @map("alert_id")
  vehicleId      Int       @map("vehicle_id")
  rentalId       Int?      @map("rental_id")
  alertType      AlertType @map("alert_type")
  latitude       Decimal?  @db.Decimal(10, 7)
  longitude      Decimal?  @db.Decimal(10, 7)
  alertMessage   String?   @map("alert_message") @db.Text
  isAcknowledged Boolean   @default(false) @map("is_acknowledged")
  acknowledgedAt DateTime? @map("acknowledged_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  resolvedAt     DateTime? @map("resolved_at")
  rental         Rental?   @relation(fields: [rentalId], references: [rentalId])
  vehicle        Vehicle   @relation(fields: [vehicleId], references: [vehicleId])

  @@index([vehicleId, createdAt])
  @@index([rentalId], map: "vehicle_alerts_rental_id_fkey")
  @@map("vehicle_alerts")
}

enum GpsStatus {
  online
  offline
}

enum AlertType {
  accident
  impact
  out_of_zone
  disconnected
}

model Vehicle {
  vehicleId         Int                       @id @default(autoincrement()) @map("vehicle_id")
  plateNumber       String                    @unique @map("plate_number") @db.VarChar(20)
  vehicleName       String                    @map("vehicle_name") @db.VarChar(100)
  vehicleType       String                    @map("vehicle_type") @db.VarChar(50)
  brand             String?                   @db.VarChar(50)
  model             String?                   @db.VarChar(50)
  color             String?                   @db.VarChar(30)
  yearManufactured  Int?                      @map("year_manufactured")
  status            VehicleStatus             @default(available)
  totalKm           Decimal                   @default(0.00) @map("total_km") @db.Decimal(10, 2)
  createdAt         DateTime                  @default(now()) @map("created_at")
  gpsLogs           GpsLog[]
  maintenanceLogs   MaintenanceLog[]
  monthlyReports    MonthlyReport[]
  rentals           Rental[]
  alerts            VehicleAlert[]
  deviceAssignments VehicleDeviceAssignment[]
  geofenceLogs      VehicleGeofenceLog[]

  @@map("vehicles")
}

model IotDevice {
  deviceId        Int                       @id @default(autoincrement()) @map("device_id")
  serialNumber    String                    @unique @map("serial_number") @db.VarChar(100)
  mqttTopic       String                    @map("mqtt_topic") @db.VarChar(200)
  simNumber       String?                   @map("sim_number") @db.VarChar(20)
  firmwareVersion String?                   @map("firmware_version") @db.VarChar(50)
  lastOnlineAt    DateTime?                 @map("last_online_at")
  status          DeviceStatus              @default(offline)
  createdAt       DateTime                  @default(now()) @map("created_at")
  assignments     VehicleDeviceAssignment[]

  @@map("iot_devices")
}

model VehicleDeviceAssignment {
  assignmentId Int       @id @default(autoincrement()) @map("assignment_id")
  vehicleId    Int       @map("vehicle_id")
  deviceId     Int       @map("device_id")
  assignedAt   DateTime  @default(now()) @map("assigned_at")
  removedAt    DateTime? @map("removed_at")
  isActive     Boolean   @default(true) @map("is_active")
  device       IotDevice @relation(fields: [deviceId], references: [deviceId])
  vehicle      Vehicle   @relation(fields: [vehicleId], references: [vehicleId])

  @@index([deviceId], map: "vehicle_device_assignments_device_id_fkey")
  @@index([vehicleId], map: "vehicle_device_assignments_vehicle_id_fkey")
  @@map("vehicle_device_assignments")
}

enum VehicleStatus {
  available
  rented
  maintenance
}

enum DeviceStatus {
  online
  offline
}
